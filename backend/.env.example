# FinSight AI — Environment Variable Template
# Copy this file to .env and fill in your API key.
# NEVER commit the .env file to GitHub.

# Option A: Google Gemini (free — get key at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=AIza...your-key-here...

# Option B: OpenAI (get key at https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-proj-...your-key-here...
