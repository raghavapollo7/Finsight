# FinSight AI — Environment Variable Template
# Copy this file to .env and fill in ONE of the options below.
# NEVER commit the .env file to GitHub.
#
# Providers are tried in this order: Groq → OpenAI → Gemini

# ── Option A: Groq (RECOMMENDED — 100% free, no credit card) ────────────────
# Get a free key in ~30 seconds: https://console.groq.com/keys
# Open-weight OpenAI-compatible models (gpt-oss). RAG retrieval automatically
# falls back to BM25 keyword search (no embedding API needed).
# GROQ_API_KEY=gsk_...your-key-here...
# Optional overrides:
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Option B: Google Gemini (free tier; some accounts need billing enabled) ──
# Get a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...your-key-here...

# ── Option C: OpenAI (paid) ──────────────────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...your-key-here...

# ── Optional: OCR mode ───────────────────────────────────────────────────────
# "llm_vision" sends document images to Gemini vision instead of Tesseract.
# EXTRACTION_MODE=llm_vision
